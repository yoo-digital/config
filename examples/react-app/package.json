{
  "name": "@yoo-digital/example-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "pnpm lint:ts && pnpm lint:css",
    "lint:ts": "eslint ./src",
    "lint:css": "stylelint './src/**/*.css'",
    "start": "vite preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "react": "~19.2.8",
    "react-dom": "~19.2.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@typescript-eslint/parser": "~8.68.0",
    "@vitejs/plugin-react": "~6.1.1",
    "@yoo-digital/eslint-config-react": "workspace:~",
    "@yoo-digital/prettier": "workspace:~",
    "@yoo-digital/stylelint-config-css": "workspace:~",
    "eslint": "~10.9.1",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "eslint-plugin-react-refresh": "~0.5.5",
    "globals": "~17.11.0",
    "prettier": "~3.9.6",
    "stylelint": "~17.14.1",
    "typescript": "~6.0.3",
    "vite": "~8.2.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
