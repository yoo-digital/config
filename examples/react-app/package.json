{
  "name": "@yoo-digital/example-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "pnpm lint:ts && pnpm lint:oxlint && pnpm lint:css",
    "lint:ts": "eslint ./src",
    "lint:oxlint": "oxlint ./src",
    "lint:css": "stylelint './src/**/*.css'",
    "start": "vite preview",
    "format": "oxfmt -c ../../oxfmt.config.mts",
    "format:check": "oxfmt -c ../../oxfmt.config.mts --check"
  },
  "dependencies": {
    "react": "~19.2.8",
    "react-dom": "~19.2.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@vitejs/plugin-react": "~6.1.0",
    "@yoo-digital/eslint-config-react": "workspace:~",
    "@yoo-digital/oxlint-config-react": "workspace:~",
    "@yoo-digital/stylelint-config-css": "workspace:~",
    "eslint": "~10.9.1",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-react-hooks": "~7.1.1",
    "oxlint": "~1.91.0",
    "oxlint-tsgolint": "~7.0.2005",
    "stylelint": "~17.14.1",
    "typescript": "~6.0.3",
    "vite": "~8.2.2"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
