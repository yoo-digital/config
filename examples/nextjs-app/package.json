{
  "name": "@yoo-digital/example-nextjs-app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "pnpm lint:ts && pnpm lint:oxlint && pnpm lint:css",
    "lint:ts": "eslint -c eslint.config.mjs ./src",
    "lint:oxlint": "oxlint ./src",
    "lint:css": "stylelint './src/**/*.css'",
    "format": "oxfmt -c ../../oxfmt.config.mts",
    "format:check": "oxfmt -c ../../oxfmt.config.mts --check"
  },
  "dependencies": {
    "next": "~16.3.3",
    "react": "~19.2.8",
    "react-dom": "~19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "~3.3.6",
    "@next/eslint-plugin-next": "~16.3.3",
    "@types/node": "~24.13.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@yoo-digital/eslint-config-react": "workspace:~",
    "@yoo-digital/oxlint-config-nextjs": "workspace:~",
    "@yoo-digital/stylelint-config-css": "workspace:~",
    "eslint": "~10.9.1",
    "oxlint": "~1.91.0",
    "oxlint-tsgolint": "~7.0.2005",
    "stylelint": "~17.14.1",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
